{
  "name": "@semio/ui",
  "description": "Basic React components, built by Semio with Radix/Tailwind",
  "version": "0.1.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist/**",
    "src/styles.css",
    "src/theme.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react --publicDir",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts --external react --publicDir",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.4",
    "@react-three/fiber": "^9.0.0",
    "@semio/utils": "*",
    "@tabler/icons-react": "^3.34.0",
    "@use-gesture/react": "^10.3.0",
    "clsx": "^2.1.1",
    "jotai": "^2.11.0",
    "jotai-effect": "^2.0.2",
    "lodash": "^4.18.1",
    "match-sorter": "^6.3.4",
    "motion": "^12.4.7",
    "number-precision": "^1.6.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.4.2",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.53.2",
    "react-imask": "^7.6.0",
    "react-merge-refs": "^2.1.1",
    "react-use-measure": "^2.1.1",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@semio/eslint-config": "*",
    "@semio/typescript-config": "*",
    "@types/lodash": "^4.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "react": "^19.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
