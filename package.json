{
  "name": "@semio/ui",
  "description": "Basic React components, built by Semio with Radix/Tailwind",
  "version": "0.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semio-ai/semio-ui.git"
  },
  "homepage": "https://github.com/semio-ai/semio-ui#readme",
  "bugs": "https://github.com/semio-ai/semio-ui/issues",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.tsx",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./styles.css": "./dist/semio-ui.css"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/**",
    "src/styles.css",
    "src/theme.css",
    "NOTICE",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i make-kit/make.css -o dist/semio-ui.css --minify",
    "dev": "tsup --watch",
    "generate:icons": "node scripts/generate-icon-registry.mjs",
    "generate:icon-svgs": "node scripts/generate-icon-svgs.mjs",
    "parity:figma": "node scripts/figma-parity-check.mjs",
    "connect:parse": "figma connect parse",
    "connect:publish": "figma connect publish",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test": "vitest run --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "test:release": "node .github/tests/release-harness.mjs",
    "storybook": "storybook dev -h localhost -p 6007 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@floating-ui/react": "^0.27.4",
    "@react-three/fiber": "^9.0.0",
    "@semio/data": "^0.1.0",
    "@semio/utils": "^0.6.0",
    "@solar-icons/react-perf": "^2.1.0",
    "@tabler/icons-react": "^3.34.0",
    "@use-gesture/react": "^10.3.0",
    "clsx": "^2.1.1",
    "jotai": "^2.11.0",
    "jotai-effect": "^2.0.2",
    "lodash": "^4.18.1",
    "match-sorter": "^6.3.4",
    "motion": "^12.4.7",
    "number-precision": "^1.6.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.4.2",
    "react-colorful": "^5.6.1",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.53.2",
    "react-imask": "^7.6.0",
    "react-markdown": "^10.1.0",
    "react-merge-refs": "^2.1.1",
    "react-use-measure": "^2.1.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^10.0.1",
    "@figma/code-connect": "^2.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/drei": "^10.0.0",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-links": "^10.3.1",
    "@storybook/react-vite": "^10.3.1",
    "@tailwindcss/cli": "^4.1.3",
    "@tailwindcss/postcss": "^4.1.3",
    "@testing-library/react": "^16.0.1",
    "@types/lodash": "^4.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.3.1",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.11.0",
    "js-yaml": "^5.5.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.10",
    "prettier": "^3.3.3",
    "react": "^19.1.0",
    "react-docgen": "^8.0.4",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^19.1.0",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.1.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
