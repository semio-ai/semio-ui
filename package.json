{
  "name": "@semio/ui",
  "description": "Basic React components, built by Semio with Radix/Tailwind",
  "version": "0.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist/**",
    "src/styles.css",
    "src/theme.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react --publicDir",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts --external react --publicDir",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@semio/utils": "*",
    "@floating-ui/react": "^0.27.4",
    "@tabler/icons-react": "^2.46.0",
    "@use-gesture/react": "^10.3.0",
    "@visx/responsive": "^3.10.2",
    "clsx": "^2.1.1",
    "jotai": "^2.11.0",
    "jotai-effect": "^2.0.2",
    "lodash": "^4.17.21",
    "match-sorter": "^6.3.4",
    "motion": "^12.4.7",
    "number-precision": "^1.6.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.4.2",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.9",
    "react-hook-form": "^7.53.2",
    "react-imask": "^7.6.0",
    "react-merge-refs": "^2.1.1",
    "react-use-measure": "^2.1.1"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@semio/eslint-config": "*",
    "@semio/typescript-config": "*",
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
